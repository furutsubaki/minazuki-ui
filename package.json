{
  "name": "minazuki-ui",
  "version": "1.5.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.1.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furutsubaki/minazuki-ui"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt/module.mjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.5.*"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm create-component-d && run-p type-check \"build-only {@}\" -- && pnpm build:nuxt",
    "build:nuxt": "vite build --config vite.nuxt.config.ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "create-component-d": "node ./src/generate-component-index.js",
    "eslint": "eslint .",
    "eslint:fix": "pnpm eslint --fix",
    "lint:es": "pnpm eslint",
    "lint:es:fix": "pnpm eslint:fix",
    "lint:style": "stylelint \"**/*.css\" \"**/*.scss\" \"**/*.vue\"",
    "lint:style:fix": "pnpm run lint:style --fix",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "lint:fix": "pnpm run lint:es:fix && pnpm run lint:style:fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sb": "pnpm storybook dev --port 6006 --no-open",
    "sb:test": "test-storybook --url http://localhost:6006",
    "play:vue": "pnpm --filter playground-vue dev",
    "play:vue:build": "pnpm --filter playground-vue build",
    "play:nuxt3": "pnpm --filter playground-nuxt3 dev",
    "play:nuxt3:build": "pnpm --filter playground-nuxt3 build",
    "play:nuxt4": "pnpm --filter playground-nuxt4 dev",
    "play:nuxt4:build": "pnpm --filter playground-nuxt4 build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.14.0",
    "@acab/reset.css": ">=0.11.0",
    "@unhead/vue": ">=1.0.0",
    "@vee-validate/rules": ">=4.9.0",
    "@vee-validate/zod": ">=4.9.0",
    "@vuepic/vue-datepicker": ">=11.0.0",
    "dayjs": ">=1.0.0",
    "i18next": ">=23.0.0",
    "lucide-vue-next": ">=0.356.0",
    "vee-validate": ">=4.9.0",
    "vue": ">=3.5.0",
    "vue-router": ">=4.0.0",
    "zod": ">=3.20.0 <4.0.0",
    "zod-i18n-map": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "devalue": "^5.8.1"
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.1",
    "@eslint/js": "^10.0.1",
    "@rushstack/eslint-patch": "^1.10.4",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/vue3": "10.3.6",
    "@storybook/vue3-vite": "10.3.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^2.0.0",
    "@stylistic/stylelint-plugin": "^3.1.2",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/coverage-istanbul": "3",
    "@vitest/coverage-v8": "3",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.5.0",
    "eslint": "10.3.0",
    "eslint-plugin-storybook": "10.3.6",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "npm-run-all2": "^6.2.2",
    "postcss-nesting": "^13.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "10.3.6",
    "stylelint": "^16.19.1",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "type-fest": "^4.38.0",
    "typescript": "~5.8.3",
    "vite": "7.3.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "3",
    "vue-tsc": "^2.0.17"
  }
}
